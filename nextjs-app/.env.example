# Database
DATABASE_URL="file:./dev.db"

# AI Provider: "yandex" or "openai"
AI_PROVIDER="yandex"

# Yandex AI settings
YANDEX_API_KEY=""
YANDEX_BASE_URL="https://ai.api.cloud.yandex.net/v1"
YANDEX_PROJECT_ID=""
YANDEX_FOLDER_ID=""
YANDEX_MODEL_URI=""

# Optional prompt IDs from Yandex Studio
YANDEX_PROMPT_ID=""
YANDEX_PROMPT_ID_INSIGHTS=""
YANDEX_PROMPT_ID_REPLY=""

# OpenAI/OpenRouter settings (used when AI_PROVIDER="openai")
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_MODEL="gpt-4o-mini"
OPENROUTER_SITE_URL="http://localhost:3000"
OPENROUTER_APP_NAME="ProductReviews"

# Auth
AUTH_SECRET=""
